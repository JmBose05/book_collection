<h1>Books</h1>

<%= link_to "New Book", new_book_path %>

<ul>
  <% @books.each do |book| %>
    <li>
      <strong><%= book.title %></strong> by <%= book.author %>
      (<%= number_to_currency(book.price) %>, <%= book.published_date %>)
      <%= link_to "Show", book %>
      <%= link_to "Edit", edit_book_path(book) %>
      <%= link_to "Delete", delete_book_path(book) %>
    </li>
  <% end %>
</ul>