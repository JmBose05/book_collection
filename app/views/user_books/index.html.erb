<p style="color: green"><%= notice %></p>

<% content_for :title, "User Books" %>

<h1>User Books</h1>

<table id="user_books">
  <thead>
    <tr>
      <th>Username</th>
      <th>Book Title</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
  <% @user_books.each do |user_book| %>
    <tr>
      <td><%= user_book.user.username %></td>
      <td><%= user_book.book.title %></td>
      <td><%= link_to "Show", user_book %></td>
      <td><%= link_to "Edit", edit_user_book_path(user_book) %></td>
      <td><%= button_to "Destroy", user_book, method: :delete %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<%= link_to "New User Book", new_user_book_path %>
<%= link_to "Books", books_path %>
<%= link_to "Users", users_path %>
